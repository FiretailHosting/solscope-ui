{
	"name": "@firetailhosting/solscope-ui",
	"version": "0.6.0",
	"description": "UI component library for solscope, based on shadcn-svelte design patterns",
	"license": "MIT",
	"private": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js"
		},
		"./tokens.css": "./dist/tokens.css",
		"./globals.css": "./dist/globals.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"publint": "^0.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^8.0.0"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FiretailHosting/solscope-ui.git"
	},
	"bugs": {
		"url": "https://github.com/FiretailHosting/solscope-ui/issues"
	},
	"homepage": "https://github.com/FiretailHosting/solscope-ui#readme",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
